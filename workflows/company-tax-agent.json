    {
      "parameters": {
        "promptType": "define",
        "text": "=Regulation text and ledger rows are below.\n\nREGULATIONS:\n{{ $json.content || $json.text }}\n\nLEDGER ROWS (JSON):\n{{ JSON.stringify($('Read Income Ledger').all().map(i => i.json)) }}\n\nPeriod label: {{ $now.toFormat(\"yyyy-MM\") }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "=You are a tax computation assistant. Using ONLY the regulation text and ledger rows provided in the user message, do two things:\n\n1. For every ledger row, output: TransactionID, amount (the transaction amount taken from the ledger row), category, whether it is taxable income / a deductible expense / a non-deductible item / capital expenditure, cite the specific regulation clause it relies on, and a short note (especially for rows already flagged with a Notes hint).\n2. Compute totals: gross_income, total_deductions, taxable_income, tax_rate applied, tax_liability.\n\nReturn ONLY valid JSON matching the required schema. Include one line item per ledger row with its amount. Do not invent regulation clauses that are not in the text — if the text does not cover a case, mark regulation_ref as \"NOT COVERED\" and explain in notes."
        }
      },
      "id": "a1ea00ca-8418-48cf-a932-185fdf048ba2",
      "name": "Calculate Tax Statement",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        784,
        400
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini"
        },
        "builtInTools": {},
        "options": {
          "reasoningEffort": "low"
        }
      },
      "id": "4a20ac08-97dd-4049-9702-8ebf56fbf6ac",
      "name": "OpenAI Model (Calc)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        736,
        592
      ],
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_WITH_OPENAI_CREDENTIAL_ID",
          "name": "n8n free OpenAI API credits"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"period\": {\"type\": \"string\"},\n    \"line_items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"TransactionID\": {\"type\": \"string\"},\n          \"amount\": {\"type\": \"number\"},\n          \"category\": {\"type\": \"string\"},\n          \"taxable_or_deductible\": {\"type\": \"string\"},\n          \"regulation_ref\": {\"type\": \"string\"},\n          \"notes\": {\"type\": \"string\"}\n        }\n      }\n    },\n    \"gross_income\": {\"type\": \"number\"},\n    \"total_deductions\": {\"type\": \"number\"},\n    \"taxable_income\": {\"type\": \"number\"},\n    \"tax_rate\": {\"type\": \"number\"},\n    \"tax_liability\": {\"type\": \"number\"}\n  },\n  \"required\": [\"period\",\"line_items\",\"gross_income\",\"total_deductions\",\"taxable_income\",\"tax_rate\",\"tax_liability\"]\n}"
      },
      "id": "f605f612-033a-4b55-8108-cd602776b832",
      "name": "Statement Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        992,
        592
      ]
    },
    {
      "parameters": {
        "jsCode": "const out = $input.first().json.output || {};\nconst period = out.period || '';\nconst generatedAt = new Date().toISOString();\nconst items = (out.line_items || []).map(li => ({\n  json: {\n    Period: period,\n    TransactionID: li.TransactionID || '',\n    Amount: (li.amount != null ? li.amount : ''),\n    Category: li.category || '',\n    Taxable_or_Deductible: li.taxable_or_deductible || '',\n    Regulation: li.regulation_ref || '',\n    Notes: li.notes || '',\n    Generated_At: generatedAt,\n  },\n}));\nreturn items;"
      },
      "id": "0c21bc4d-17d3-41fd-89fb-358e7faa4283",
