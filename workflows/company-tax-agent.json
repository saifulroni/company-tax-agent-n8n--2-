    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "subject",
              "type": "string",
              "value": "=Daily Tax Statement - {{$json.output.period}} (Tax due: {{$json.output.tax_liability}})"
            },
            {
              "id": "a2",
              "name": "htmlBody",
              "type": "string",
              "value": "=<h2>Tax statement - {{$json.output.period}}</h2><p><b>Gross income:</b> {{$json.output.gross_income}}<br/><b>Total deductions:</b> {{$json.output.total_deductions}}<br/><b>Taxable income:</b> {{$json.output.taxable_income}}<br/><b>Tax rate:</b> {{$json.output.tax_rate}}<br/><b>Tax liability:</b> {{$json.output.tax_liability}}</p><h3>Line-item breakdown ({{ ($json.output.line_items || []).length }} rows)</h3><table border=\"1\" cellpadding=\"6\" cellspacing=\"0\" style=\"border-collapse:collapse;font-family:sans-serif;font-size:13px;\"><thead><tr style=\"background:#f0f0f0;\"><th>Txn ID</th><th>Amount</th><th>Category</th><th>Taxable / Deductible</th><th>Regulation</th><th>Notes</th></tr></thead><tbody>{{ ($json.output.line_items || []).map(li => \"<tr><td>\" + (li.TransactionID || \"\") + \"</td><td>\" + (li.amount != null ? li.amount : \"\") + \"</td><td>\" + (li.category || \"\") + \"</td><td>\" + (li.taxable_or_deductible || \"\") + \"</td><td>\" + (li.regulation_ref || \"\") + \"</td><td>\" + (li.notes || \"\") + \"</td></tr>\").join(\"\") }}</tbody></table><p style=\"color:#888;font-size:12px;\">These line items have been appended to the taxation statement sheet.</p>"
            }
          ]
        },
        "options": {}
      },
